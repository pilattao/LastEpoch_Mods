<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>LastEpoch.ModelSwapper</AssemblyName>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <Target Name="CheckGamePath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(LastEpochPath)/MelonLoader/Il2CppAssemblies/Il2CppLE.dll')"
           Text="Set LastEpochPath to a Last Epoch installation with generated MelonLoader interop assemblies." />
  </Target>
  <ItemGroup>
    <Reference Include="$(LastEpochPath)/MelonLoader/Il2CppAssemblies/*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(LastEpochPath)/MelonLoader/net6/MelonLoader.dll"><Private>false</Private></Reference>
    <Reference Include="$(LastEpochPath)/MelonLoader/net6/0Harmony.dll"><Private>false</Private></Reference>
    <Reference Include="$(LastEpochPath)/MelonLoader/net6/Il2CppInterop.Runtime.dll"><Private>false</Private></Reference>
    <Reference Include="$(LastEpochPath)/MelonLoader/net6/Il2CppInterop.Common.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
